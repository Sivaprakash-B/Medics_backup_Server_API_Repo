# ── Environment ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dbname
DB_USER=api_user
DB_PASSWORD=change-me

# JWT
SECRET_KEY=replace-with-a-64-char-random-hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_TITLE=SEF Internal Data API
ALLOWED_ORIGINS=https://your-frontend.sef.local
